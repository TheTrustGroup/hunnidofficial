# Inventory API base URL (required in production). No trailing slash.
# Local: http://localhost:3001  |  Production: https://your-api.vercel.app
VITE_API_BASE_URL=

# Optional: Supabase for product image storage (POS/Inventory show images from these URLs).
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
# VITE_SUPABASE_IMAGE_TRANSFORMS=true  # optional; requires Supabase Pro for /render/image

# Offline: IndexedDB product sync queue (inventory). Default off in production until ready.
# VITE_OFFLINE_ENABLED=true
# VITE_OFFLINE_ROLLOUT_PERCENT=100

# POS sale outbox when API unreachable (default on). Set false to block checkout offline.
# VITE_POS_SALE_OUTBOX=true
